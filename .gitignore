# ============================================================================
# .gitignore — PT Sopiak Satria Saga
# Tahap 10 Bug #8 (P3-7): expanded coverage for artifacts that should never
# be in git after 9 rounds of refactor.
# ============================================================================

# --- Environment ---
.env
.env.*
.env.local
!.env.example
!web-admin-next/.env.production

# --- Node dependencies (rebuilt per environment) ---
node_modules/

# --- Build outputs ---
dist/
build/
.next/
.expo/
out/
**/.next/
**/dist/

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-error.log
yarn-debug.log*
pnpm-debug.log*

# --- Runtime-generated uploads (live on server volume, not in git) ---
uploads/

# --- Test artifacts ---
coverage/
.nyc_output/

# --- Backup / temp files from deploy workflow ---
# Common patterns from Tahap 1-9 manual file replacements:
*.backup
*.bak
*.tahap*-backup
*.tahap*-fix.zip
docker-compose.yml.tahap*
sopiak-*-fix.zip
sopiak-satria-saga.zip

# --- next-pwa generated (regenerated by next-pwa plugin on every build) ---
public/sw.js
public/sw.js.map
public/workbox-*.js
public/workbox-*.js.map
web-admin-next/public/sw.js
web-admin-next/public/sw.js.map
web-admin-next/public/workbox-*.js
web-admin-next/public/workbox-*.js.map

# --- generate-icons.js prebuild output ---
public/icons/
web-admin-next/public/icons/

# --- Mobile / Expo ---
.expo/
.expo-shared/
downloads/*.apk
apk-output/
android/
ios/

# --- Secrets / credentials (never commit) ---
*.pem
*.key
*.cert
docker/nginx/ssl/fullchain.pem
docker/nginx/ssl/privkey.pem
backend/firebase-service-account.json

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- IDE / editor ---
.vscode/
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~

# --- Tahap 10 Bug #8: documentation artifacts that don't belong in deploy image ---
LAPORAN_VERIFIKASI.md
verify/
TAHAP_*.md
!TAHAP_PERBAIKAN_SOPIAK.md