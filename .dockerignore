# Build context excludes for ALL Dockerfiles in this repo.
# We rely on per-Dockerfile COPY to pick what each image needs.

# VCS / IDE
.git
.gitignore
.vscode
.idea

# Mobile-only artifacts (never needed by backend / web-admin / website builds)
android
ios
.expo
.expo-shared
apk-output

# Node deps — they're rebuilt inside each image
**/node_modules

# Build outputs
**/.next
**/dist
**/build
**/tsconfig.tsbuildinfo

# next-pwa generated files (regenerated on every build by next-pwa plugin)
web-admin-next/public/sw.js
web-admin-next/public/sw.js.map
web-admin-next/public/workbox-*.js
web-admin-next/public/workbox-*.js.map

# generate-icons.js prebuild output (regenerated by web-admin-next prebuild step)
web-admin-next/public/icons

# Logs / temp
**/*.log
**/.DS_Store
**/Thumbs.db

# Env files MUST NOT leak into images
.env
.env.local
.env.*.local

# Docs / packaging — not used at runtime
*.zip
PANDUAN_DEPLOY_COOLIFY.md
README.md
