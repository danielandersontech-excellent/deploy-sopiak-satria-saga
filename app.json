{
  "expo": {
    "name": "PT Sopiak Satria Saga",
    "slug": "sopiak-satria-saga",
    "version": "3.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo-ptsss.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/logo-ptsss.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a5276"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ptsss.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo-ptsss.png",
        "backgroundColor": "#1a5276"
      },
      "package": "com.ptsss.mobile",
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "POST_NOTIFICATIONS",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "VIBRATE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "sopiaksatriasaga.com"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/logo-ptsss.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "PT Sopiak Satria Saga memerlukan akses kamera untuk foto absensi, dokumentasi laporan, dan scan QR checkpoint."
        }
      ],
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "PT Sopiak Satria Saga memerlukan akses lokasi untuk tracking patroli keamanan.",
          "locationAlwaysPermission": "Diperlukan untuk tracking patroli saat aplikasi berjalan di background.",
          "locationWhenInUsePermission": "Diperlukan untuk fitur absensi dan patroli."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PT Sopiak Satria Saga memerlukan akses galeri untuk upload dokumentasi laporan.",
          "cameraPermission": "PT Sopiak Satria Saga memerlukan akses kamera untuk foto dokumentasi."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/logo-ptsss.png",
          "color": "#1a5276"
        }
      ],
      "expo-sqlite",
      "expo-asset",
      "expo-font"
    ],
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "url": "https://u.expo.dev/3e12dbd3-03f5-4d81-b4f3-be851a8d8956"
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "extra": {
      "apiUrl": "https://api.sopiaksatriasaga.com",
      "eas": {
        "projectId": "3e12dbd3-03f5-4d81-b4f3-be851a8d8956"
      }
    }
  }
}
