# ================================
# PT Sopiak Satria Saga Backend - Environment Config
# ================================

# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ptsss_db
DB_USER=postgres
DB_PASSWORD=

# JWT Secret - WAJIB ganti dengan random string 64+ karakter!
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=GANTI_INI_DENGAN_RANDOM_STRING_64_KARAKTER
JWT_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7d

# Bcrypt
BCRYPT_ROUNDS=12

# File Upload
UPLOAD_DIR=./uploads
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760
MAX_FILE_SIZE_MB=10

# CORS - domain spesifik (pisahkan dengan koma)
CORS_ORIGIN=http://localhost:3001,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000

# API URL (untuk generate links)
API_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Firebase Cloud Messaging (push notifications)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Google Drive CDN (optional)
DRIVE_CDN_ENABLED=false
DRIVE_FOLDER_ID=YOUR_GOOGLE_DRIVE_FOLDER_ID
DRIVE_CREDENTIALS_PATH=./drive-credentials.json
