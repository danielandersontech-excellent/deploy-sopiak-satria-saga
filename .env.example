# ============================================================
# PT Sopiak Satria Saga — Environment Variables (Coolify edition)
# ============================================================
#
# Usage:
#   1) LOCAL DEV (docker compose up):
#        cp .env.example .env
#        # Edit values. For HTTP set COOKIE_SECURE=false, COOKIE_DOMAIN= (empty)
#
#   2) COOLIFY DEPLOY:
#        Coolify → Environment Variables → Developer view.
#        Paste this into BOTH "Production" AND "Preview Deployments" boxes.
#        Coolify won't Save unless required keys exist in Preview too.
#
# Generate secrets:
#   openssl rand -base64 48     # JWT_SECRET, RATE_LIMIT_BYPASS_SECRET
#   openssl rand -base64 24     # DB_PASSWORD, PGADMIN_PASSWORD
# ============================================================

# ─── Database (Postgres service inside compose) ───
DB_NAME=ptsss_db
DB_USER=ptsss_user
DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
# DB_HOST hard-wired to "postgres" in compose. DB_SSL only for external Postgres.
DB_SSL=false

# ─── Backend / Auth ───
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_BASE64
JWT_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
MAX_FILE_SIZE=10485760

# Bootstrap behavior on startup:
#   true        → load schema if missing AND seed default users (FIRST deploy)
#   schema-only → load schema if missing, do NOT seed users
#   false       → skip everything
AUTO_BOOTSTRAP=true

# Pagination tuning
DEFAULT_PAGE_SIZE=25
MAX_PAGE_SIZE=200

RATE_LIMIT_BYPASS_SECRET=

# ─── CORS / Cookie config (CRITICAL for cross-subdomain auth) ───
CORS_ORIGIN=https://sopiaksatriasaga.com,https://www.sopiaksatriasaga.com,https://hq.sopiaksatriasaga.com,https://api.sopiaksatriasaga.com
API_URL=https://api.sopiaksatriasaga.com

# COOKIE_DOMAIN: leading DOT — cookie covers BOTH subdomains. Without dot, login loops.
# COOKIE_SECURE: true behind HTTPS, false for plain HTTP.
# COOKIE_SAMESITE: lax single-domain, none cross-site (requires Secure=true).
COOKIE_DOMAIN=.sopiaksatriasaga.com
COOKIE_SECURE=true
COOKIE_SAMESITE=none

# ─── Web Admin build-time vars (Next.js) — baked into bundle ───
NEXT_PUBLIC_API_URL=https://api.sopiaksatriasaga.com
NEXT_PUBLIC_SOCKET_URL=https://api.sopiaksatriasaga.com

# ─── Coolify magic FQDN vars (Traefik routing — leave blank, Coolify fills) ───
SERVICE_FQDN_BACKEND_3000=
SERVICE_FQDN_WEBADMIN_3001=
SERVICE_FQDN_WEBSITE_3002=
SERVICE_FQDN_PGADMIN_80=

# ─── pgAdmin ───
PGADMIN_EMAIL=admin@sopiaksatriasaga.com
PGADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ─── Firebase Cloud Messaging — OPTIONAL ───
# Without these, Expo Push still works; only NATIVE FCM disabled.
# Coolify-friendly: paste 3 fields from service-account.json separately.
# FIREBASE_PRIVATE_KEY: paste full PEM as ONE line with literal \n.
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=